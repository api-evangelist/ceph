{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ceph Manager REST Auth Daemon API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Daemon",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List daemons",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{manager_host}:{dashboard_port}/api/daemon",
            "params": [
              {
                "name": "daemon_type",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List cluster daemons with optional type filtering."
        },
        {
          "info": {
            "name": "Daemon action",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{manager_host}:{dashboard_port}/api/daemon/:daemon_name",
            "params": [
              {
                "name": "daemon_name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a daemon action such as restart or upgrade."
        }
      ]
    }
  ],
  "bundled": true
}